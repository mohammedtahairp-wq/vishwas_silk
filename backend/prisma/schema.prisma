generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  rider
  customer
}

enum Status {
  active
  inactive
}

enum PickupStatus {
  pending
  included_in_settlement
  paid
}

enum TransactionStatus {
  pending
  paid
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  // Polymorphic pointer: Customer.id when role=customer, Rider.id when role=rider, null for admin.
  // Not a Prisma relation because it targets different tables depending on role; resolved in app code.
  linkedId     String?  @map("linked_id")
  status       Status   @default(active)
  createdAt    DateTime @default(now()) @map("created_at")

  createdCustomers    Customer[]             @relation("CustomerCreatedBy")
  createdPrices       CustomerProductPrice[]
  createdTransactions Transaction[]

  @@map("users")
}

model Customer {
  id              String   @id @default(uuid())
  serialNumber    String?  @unique @map("serial_number")
  name            String
  phone           String   @unique
  address         String?
  villageArea     String?  @map("village_area")
  assignedRiderId String?  @map("assigned_rider_id")
  status          Status   @default(active)
  createdById     String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  assignedRider Rider?                 @relation(fields: [assignedRiderId], references: [id])
  createdBy     User                   @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  prices        CustomerProductPrice[]
  pickups       Pickup[]
  transactions  Transaction[]

  @@map("customers")
}

model Rider {
  id          String   @id @default(uuid())
  name        String
  phone       String   @unique
  villageArea String?  @map("village_area")
  status      Status   @default(active)
  createdAt   DateTime @default(now()) @map("created_at")

  customers Customer[]
  pickups   Pickup[]

  @@map("riders")
}

model Product {
  id        String   @id @default(uuid())
  name      String   @unique
  unit      String   @default("kg")
  status    Status   @default(active)
  createdAt DateTime @default(now()) @map("created_at")

  prices               CustomerProductPrice[]
  pickups              Pickup[]
  transactionLineItems TransactionLineItem[]

  @@map("products")
}

model City {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("cities")
}

model CustomerProductPrice {
  id            String   @id @default(uuid())
  customerId    String?  @map("customer_id")
  productId     String   @map("product_id")
  pricePerKg    Decimal  @map("price_per_kg") @db.Decimal(12, 2)
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdById   String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  customer  Customer? @relation(fields: [customerId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([customerId, productId, effectiveFrom])
  @@map("customer_product_prices")
}

model Pickup {
  id                 String       @id @default(uuid())
  customerId         String       @map("customer_id")
  riderId            String       @map("rider_id")
  productId          String       @map("product_id")
  kg                 Decimal      @db.Decimal(10, 2)
  pickupDate         DateTime     @default(now()) @map("pickup_date") @db.Date
  // Hidden from rider/customer API responses — see src/serializers/pickup.serializer.ts
  pricePerKgSnapshot Decimal      @map("price_per_kg_snapshot") @db.Decimal(12, 2)
  amount             Decimal      @db.Decimal(12, 2)
  status             PickupStatus @default(pending)
  createdAt          DateTime     @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id])
  rider    Rider    @relation(fields: [riderId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([customerId, pickupDate])
  @@index([riderId, pickupDate])
  @@map("pickups")
}

model Transaction {
  id          String            @id @default(uuid())
  customerId  String            @map("customer_id")
  month       Int
  year        Int
  fromDate    DateTime?         @map("from_date") @db.Date
  toDate      DateTime?         @map("to_date") @db.Date
  totalKg     Decimal           @map("total_kg") @db.Decimal(10, 2)
  totalAmount Decimal           @map("total_amount") @db.Decimal(12, 2)
  status      TransactionStatus @default(pending)
  paidDate    DateTime?         @map("paid_date") @db.Date
  createdById String            @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")

  customer  Customer              @relation(fields: [customerId], references: [id])
  createdBy User                  @relation(fields: [createdById], references: [id])
  lineItems TransactionLineItem[]

  @@unique([customerId, month, year])
  @@map("transactions")
}

model TransactionLineItem {
  id            String  @id @default(uuid())
  transactionId String  @map("transaction_id")
  productId     String  @map("product_id")
  totalKg       Decimal @map("total_kg") @db.Decimal(10, 2)
  pricePerKg    Decimal @map("price_per_kg") @db.Decimal(12, 2)
  amount        Decimal @db.Decimal(12, 2)

  transaction Transaction @relation(fields: [transactionId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])

  @@map("transaction_line_items")
}
