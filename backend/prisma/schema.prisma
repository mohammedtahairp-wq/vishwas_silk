generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  rider
  customer
}

enum Status {
  active
  inactive
}

enum PickupStatus {
  pending
  included_in_settlement
  paid
}

enum TransactionStatus {
  pending
  paid
}

enum EmployeeCategory {
  sheet_machine
  ovendry
  khalla_jala
  drivers_helpers
}

enum SalaryPaymentType {
  advance
  salary
}

enum TransportExpenseCategory {
  diesel
  repair
}

enum MaintenanceExpenseCategory {
  food
  machinery
  others
}

enum Unit {
  kolar
  sidlagatta
  ramnagar
}

model User {
  id           String   @id @default(uuid())
  loginPhone   String?  @unique @map("login_phone")
  role         Role
  // Polymorphic pointer: Customer.id when role=customer, Rider.id when role=rider, null for admin.
  // Not a Prisma relation because it targets different tables depending on role; resolved in app code.
  linkedId     String?  @map("linked_id")
  status       Status   @default(active)
  createdAt    DateTime @default(now()) @map("created_at")

  createdCustomers    Customer[]             @relation("CustomerCreatedBy")
  createdPrices       CustomerProductPrice[]
  createdTransactions Transaction[]
  createdSalaries     SalaryPayment[]        @relation("SalaryPaymentCreatedBy")
  createdTransport    TransportExpense[]     @relation("TransportExpenseCreatedBy")
  createdMaintenance  MaintenanceExpense[]   @relation("MaintenanceExpenseCreatedBy")
  createdDieselLogs   DieselLog[]            @relation("DieselLogCreatedBy")

  @@map("users")
}

model Customer {
  id              String   @id @default(uuid())
  serialNumber    String?  @unique @map("serial_number")
  name            String
  phone           String   @unique
  address         String?
  villageArea     String?  @map("village_area")
  cityId          String?  @map("city_id")
  assignedRiderId String?  @map("assigned_rider_id")
  status          Status   @default(active)
  createdById     String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  assignedRider Rider?                 @relation(fields: [assignedRiderId], references: [id])
  city          City?                  @relation(fields: [cityId], references: [id])
  createdBy     User                   @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  prices        CustomerProductPrice[]
  pickups       Pickup[]
  transactions  Transaction[]

  @@map("customers")
}

model Rider {
  id          String   @id @default(uuid())
  name        String
  phone       String   @unique
  villageArea String?  @map("village_area")
  status      Status   @default(active)
  createdAt   DateTime @default(now()) @map("created_at")

  customers Customer[]
  pickups   Pickup[]
  dieselLogs DieselLog[]

  @@map("riders")
}

model Product {
  id        String   @id @default(uuid())
  name      String   @unique
  unit      String   @default("kg")
  status    Status   @default(active)
  createdAt DateTime @default(now()) @map("created_at")

  prices               CustomerProductPrice[]
  pickups              Pickup[]
  transactionLineItems TransactionLineItem[]

  @@map("products")
}

model City {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now()) @map("created_at")
  customers Customer[]

  @@map("cities")
}

model CustomerProductPrice {
  id            String   @id @default(uuid())
  customerId    String?  @map("customer_id")
  productId     String   @map("product_id")
  pricePerKg    Decimal  @map("price_per_kg") @db.Decimal(12, 2)
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdById   String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  customer  Customer? @relation(fields: [customerId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([customerId, productId, effectiveFrom])
  @@map("customer_product_prices")
}

model Pickup {
  id                 String       @id @default(uuid())
  customerId         String       @map("customer_id")
  riderId            String       @map("rider_id")
  productId          String       @map("product_id")
  kg                 Decimal      @db.Decimal(10, 2)
  pickupDate         DateTime     @default(now()) @map("pickup_date") @db.Date
  // Hidden from rider/customer API responses — see src/serializers/pickup.serializer.ts
  pricePerKgSnapshot Decimal      @map("price_per_kg_snapshot") @db.Decimal(12, 2)
  amount             Decimal      @db.Decimal(12, 2)
  status             PickupStatus @default(pending)
  paidFromDate       DateTime?    @map("paid_from_date") @db.Date
  paidToDate         DateTime?    @map("paid_to_date") @db.Date
  createdAt          DateTime     @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id])
  rider    Rider    @relation(fields: [riderId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([customerId, pickupDate])
  @@index([riderId, pickupDate])
  @@map("pickups")
}

model Transaction {
  id          String            @id @default(uuid())
  customerId  String            @map("customer_id")
  month       Int
  year        Int
  fromDate    DateTime?         @map("from_date") @db.Date
  toDate      DateTime?         @map("to_date") @db.Date
  totalKg     Decimal           @map("total_kg") @db.Decimal(10, 2)
  totalAmount Decimal           @map("total_amount") @db.Decimal(12, 2)
  status      TransactionStatus @default(pending)
  paidDate    DateTime?         @map("paid_date") @db.Date
  createdById String            @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")

  customer  Customer              @relation(fields: [customerId], references: [id])
  createdBy User                  @relation(fields: [createdById], references: [id])
  lineItems TransactionLineItem[]

  @@unique([customerId, month, year])
  @@map("transactions")
}

model TransactionLineItem {
  id            String  @id @default(uuid())
  transactionId String  @map("transaction_id")
  productId     String  @map("product_id")
  totalKg       Decimal @map("total_kg") @db.Decimal(10, 2)
  pricePerKg    Decimal @map("price_per_kg") @db.Decimal(12, 2)
  amount        Decimal @db.Decimal(12, 2)

  transaction Transaction @relation(fields: [transactionId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])

  @@map("transaction_line_items")
}

// ---- Phase 2: Operations (salary / transport / maintenance) ----

model Employee {
  id            String           @id @default(uuid())
  name          String
  phone         String?
  category      EmployeeCategory
  unit          Unit             @default(kolar)
  monthlySalary Decimal          @map("monthly_salary") @db.Decimal(12, 2)
  status        Status           @default(active)
  createdAt     DateTime         @default(now()) @map("created_at")

  salaryPayments SalaryPayment[]

  @@index([category])
  @@index([unit])
  @@map("employees")
}

model SalaryPayment {
  id          String            @id @default(uuid())
  employeeId  String            @map("employee_id")
  type        SalaryPaymentType
  unit        Unit              @default(kolar)
  amount      Decimal           @db.Decimal(12, 2)
  month       Int
  year        Int
  paymentDate DateTime          @default(now()) @map("payment_date") @db.Date
  note        String?
  createdById String            @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")

  employee  Employee @relation(fields: [employeeId], references: [id])
  createdBy User     @relation("SalaryPaymentCreatedBy", fields: [createdById], references: [id])

  @@index([employeeId, year, month])
  @@index([unit, year, month])
  @@map("salary_payments")
}

model Vehicle {
  id        String   @id @default(uuid())
  name      String
  number    String   @unique
  unit      Unit     @default(kolar)
  status    Status   @default(active)
  createdAt DateTime @default(now()) @map("created_at")

  transportExpenses TransportExpense[]
  dieselLogs        DieselLog[]

  @@index([unit])
  @@map("vehicles")
}

model TransportExpense {
  id          String                   @id @default(uuid())
  vehicleId   String                   @map("vehicle_id")
  category    TransportExpenseCategory
  unit        Unit                     @default(kolar)
  amount      Decimal                  @db.Decimal(12, 2)
  expenseDate DateTime                 @default(now()) @map("expense_date") @db.Date
  description String?
  createdById String                   @map("created_by")
  createdAt   DateTime                 @default(now()) @map("created_at")

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  createdBy User    @relation("TransportExpenseCreatedBy", fields: [createdById], references: [id])

  @@index([vehicleId, expenseDate])
  @@index([expenseDate])
  @@index([unit, expenseDate])
  @@map("transport_expenses")
}

model MaintenanceExpense {
  id          String                      @id @default(uuid())
  category    MaintenanceExpenseCategory
  unit        Unit                        @default(kolar)
  amount      Decimal                     @db.Decimal(12, 2)
  expenseDate DateTime                    @default(now()) @map("expense_date") @db.Date
  description String
  createdById String                      @map("created_by")
  createdAt   DateTime                    @default(now()) @map("created_at")

  createdBy User @relation("MaintenanceExpenseCreatedBy", fields: [createdById], references: [id])

  @@index([expenseDate])
  @@index([unit, expenseDate])
  @@map("maintenance_expenses")
}

// Rider diesel fill log with KM readings (start km before fill, end km after run).
model DieselLog {
  id           String   @id @default(uuid())
  vehicleId    String   @map("vehicle_id")
  riderId      String   @map("rider_id")
  unit         Unit     @default(kolar)
  dieselDate   DateTime @map("diesel_date") @db.Date
  dieselAmount Decimal  @map("diesel_amount") @db.Decimal(12, 2)
  startKm      Decimal  @map("start_km") @db.Decimal(10, 2)
  endKm        Decimal  @map("end_km") @db.Decimal(10, 2)
  // km run = endKm - startKm, precomputed in the service for reporting.
  kmRun        Decimal  @map("km_run") @db.Decimal(10, 2)
  createdById  String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  rider     Rider   @relation(fields: [riderId], references: [id])
  createdBy User    @relation("DieselLogCreatedBy", fields: [createdById], references: [id])

  @@index([vehicleId, dieselDate])
  @@index([riderId, dieselDate])
  @@index([unit, dieselDate])
  @@map("diesel_logs")
}
